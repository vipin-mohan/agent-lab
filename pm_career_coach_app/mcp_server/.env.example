# PM Career Coach MCP Server — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real secrets.

# ---------------------------------------------------------------------------
# Authentication (REQUIRED)
# ---------------------------------------------------------------------------

# Static bearer token for MCP clients. Generate a long random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=your-long-random-secret-here

# ---------------------------------------------------------------------------
# LLM providers — at least ONE is required
# Priority: ANTHROPIC > OPENAI > GEMINI
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ---------------------------------------------------------------------------
# RAG pipeline (REQUIRED for grounded responses)
# ---------------------------------------------------------------------------

# Pinecone API key — connects to the vector index
PINECONE_API_KEY=pcsk-...
# Pinecone index name — defaults to "coaching-notes" if not set
PINECONE_INDEX_NAME=coaching-notes
