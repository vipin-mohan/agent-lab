# PM Career Coach A2A Server — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real secrets.

# ---------------------------------------------------------------------------
# Authentication (REQUIRED)
# The server refuses to start without this. Generate a long random secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
A2A_BEARER_TOKEN=your-long-random-secret-here

# ---------------------------------------------------------------------------
# Server configuration (optional — defaults shown)
# ---------------------------------------------------------------------------
A2A_PUBLIC_URL=http://localhost:8000
A2A_HOST=0.0.0.0
A2A_PORT=8000
A2A_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM providers — at least ONE is required
# Priority used by core/: ANTHROPIC > OPENAI > GEMINI
# ANTHROPIC_API_KEY is also required for tool-use routing in router.py
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ---------------------------------------------------------------------------
# RAG pipeline (REQUIRED for grounded responses)
# ---------------------------------------------------------------------------
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX_NAME=coaching-notes
